generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// NOTE: SQLite dev / PostgreSQL prod-ready. All relations + indexes mirror the
// production Postgres design (see README deployment notes for switching provider).

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  firstName    String?
  lastName    String?
  mobile       String?
  passwordHash String
  emailVerified DateTime?
  role         String    @default("customer") // customer | support | marketing | content | inventory | catalogue | orders | admin | superadmin
  status       String    @default("active")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  profile      UserProfile?
  roles        UserRole[]
  addresses    Address[]
  orders       Order[]
  reviews      Review[]
  wishlists    Wishlist[]
  carts        Cart[]
  returns      Return[]
  auditLogs    AuditLog[]
  notifications Notification[]
  recentlyViewed RecentlyViewed[]
  priceAlerts  PriceAlert[]
}

model UserProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatar    String?
  marketingOptIn Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Role {
  id          String       @id @default(cuid())
  key         String       @unique
  name        String
  permissions String       @default("[]") // JSON array
  users       UserRole[]
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@unique([userId, roleId])
}

model Address {
  id          String  @id @default(cuid())
  userId      String?
  user        User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  firstName   String
  lastName    String
  company     String?
  street      String
  unit        String?
  suburb      String
  state       String
  postcode    String
  country     String  @default("AU")
  mobile      String?
  instructions String?
  isDefault   Boolean @default(false)
  createdAt   DateTime @default(now())
}

model Brand {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  logo        String?
  hero        String?
  website     String?
  active      Boolean   @default(true)
  seoTitle    String?
  seoDescription String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Category {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  description   String?
  seoText       String?
  icon          String?
  thumbnail     String?
  heroImage     String?
  mobileHero    String?
  parentId      String?
  parent        Category? @relation("CatTree", fields: [parentId], references: [id])
  children      Category[] @relation("CatTree")
  sortOrder     Int       @default(0)
  showInNav     Boolean   @default(true)
  showOnHome    Boolean   @default(false)
  status        String    @default("active")
  seoTitle      String?
  seoDescription String?
  deletedAt     DateTime?
  products      ProductCategory[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Product {
  id              String   @id @default(cuid())
  slug            String   @unique
  sku             String   @unique
  barcode         String?
  title           String
  subtitle        String?
  shortDescription String?
  description     String?
  brandId         String?
  brand           Brand?   @relation(fields: [brandId], references: [id])
  supplier        String?
  price           Int      // cents, GST-inclusive
  compareAtPrice  Int?
  costPrice       Int?
  salePrice       Int?
  saleStart       DateTime?
  saleEnd         DateTime?
  status          String   @default("active") // draft | active | scheduled | archived
  featured        Boolean  @default(false)
  bestSeller      Boolean  @default(false)
  isNew           Boolean  @default(false)
  clearance       Boolean  @default(false)
  onlineOnly      Boolean  @default(false)
  stock           Int      @default(0)
  lowStockAt      Int      @default(5)
  weightGrams     Int?
  dimensions      String?
  bulky           Boolean  @default(false)
  ratingAvg       Float    @default(0)
  ratingCount     Int      @default(0)
  seoTitle        String?
  seoDescription  String?
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  images          ProductImage[]
  videos          ProductVideo[]
  variants        ProductVariant[]
  categories      ProductCategory[]
  attributes      ProductAttribute[]
  inventory       Inventory[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
  wishlistItems   WishlistItem[]
  reviews         Review[]
  returnItems     ReturnItem[]
  recentlyViewed  RecentlyViewed[]
  priceAlerts     PriceAlert[]
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  @@id([productId, categoryId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int     @default(0)
}

model ProductVideo {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  poster    String?
  sortOrder Int     @default(0)
}

model ProductVariant {
  id         String  @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String
  sku        String  @unique
  barcode    String?
  image      String?
  price      Int?
  salePrice  Int?
  stock      Int     @default(0)
  weightGrams Int?
  attributes String  @default("{}")
}

model Attribute {
  id     String @id @default(cuid())
  key    String @unique
  label  String
  values AttributeValue[]
}

model AttributeValue {
  id          String @id @default(cuid())
  attributeId String
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value       String
  products    ProductAttribute[]
}

model ProductAttribute {
  productId String
  attributeValueId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeValue AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)
  @@id([productId, attributeValueId])
}

model Warehouse {
  id        String @id @default(cuid())
  name      String
  code      String @unique
  suburb    String?
  state     String?
  active    Boolean @default(true)
  inventory Inventory[]
}

model Inventory {
  id          String @id @default(cuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  onHand      Int @default(0)
  allocated   Int @default(0)
  incoming    Int @default(0)
  damaged     Int @default(0)
  @@unique([productId, warehouseId])
}

model InventoryMovement {
  id          String   @id @default(cuid())
  productId   String
  warehouseId String?
  qty         Int
  type        String
  reference   String?
  note        String?
  actorId     String?
  createdAt   DateTime @default(now())
}

model Cart {
  id        String @id @default(cuid())
  userId    String?
  user      User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId String?
  couponCode String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items     CartItem[]
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  cart      Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  variantId String?
  qty       Int @default(1)
  unitPrice Int
}

model Wishlist {
  id        String @id @default(cuid())
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String @default("My Wishlist")
  items     WishlistItem[]
  createdAt DateTime @default(now())
}

model WishlistItem {
  id        String @id @default(cuid())
  wishlistId String
  wishlist  Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([wishlistId, productId])
}

model Coupon {
  id              String @id @default(cuid())
  code            String @unique
  description     String?
  type            String // percent | fixed | freeship
  amount          Int @default(0)
  minSpend        Int @default(0)
  maxDiscount     Int?
  allowedProducts String @default("[]")
  allowedCategories String @default("[]")
  startAt         DateTime?
  endAt           DateTime?
  usageLimit      Int?
  perCustomer     Int?
  usedCount       Int @default(0)
  enabled         Boolean @default(true)
  createdAt       DateTime @default(now())
  usages          CouponUsage[]
}

model CouponUsage {
  id       String @id @default(cuid())
  couponId String
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId   String?
  orderId  String?
  usedAt   DateTime @default(now())
}

model Promotion {
  id          String @id @default(cuid())
  title       String
  description String?
  type        String
  value       Int?
  products    String @default("[]")
  categories  String @default("[]")
  startAt     DateTime?
  endAt       DateTime?
  enabled     Boolean @default(true)
  countdown   Boolean @default(false)
}

model Order {
  id            String @id @default(cuid())
  orderNumber   String @unique
  userId        String?
  user          User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  email         String
  status        String @default("Pending")
  subtotal      Int
  discount      Int @default(0)
  shipping      Int @default(0)
  gst           Int @default(0)
  total         Int
  couponCode    String?
  shippingMethod String?
  addressJson   String @default("{}")
  paymentStatus String @default("pending")
  fulfilment    String @default("unfulfilled")
  tracking      String?
  idempotencyKey String? @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  items         OrderItem[]
  payments      Payment[]
  shipments     Shipment[]
  returns       Return[]
  timeline      OrderTimeline[]
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  title     String
  sku       String
  variant   String?
  qty       Int
  unitPrice Int
  total     Int
}

model OrderTimeline {
  id        String @id @default(cuid())
  orderId   String
  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  note      String?
  createdAt DateTime @default(now())
}

model Payment {
  id          String @id @default(cuid())
  orderId     String
  order       Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider    String
  reference   String?
  amount      Int
  status      String @default("pending")
  rawJson     String @default("{}")
  createdAt   DateTime @default(now())
}

model Shipment {
  id        String @id @default(cuid())
  orderId   String
  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  carrier   String?
  tracking  String?
  status    String @default("pending")
  events    ShipmentEvent[]
  createdAt DateTime @default(now())
}

model ShipmentEvent {
  id         String @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status     String
  note       String?
  createdAt  DateTime @default(now())
}

model Return {
  id        String @id @default(cuid())
  orderId   String
  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId    String?
  user      User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  status    String @default("requested")
  reason    String?
  note      String?
  createdAt DateTime @default(now())
  items     ReturnItem[]
}

model ReturnItem {
  id        String @id @default(cuid())
  returnId  String
  ret       Return @relation(fields: [returnId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  qty       Int @default(1)
  reason    String?
}

model Review {
  id        String @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String?
  user      User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  rating    Int
  headline  String?
  body      String?
  verified  Boolean @default(false)
  status    String @default("pending")
  response  String?
  createdAt DateTime @default(now())
}

model Banner {
  id        String @id @default(cuid())
  slot      String
  title     String
  subtitle  String?
  image     String?
  cta       String?
  url       String?
  bg        String?
  sortOrder Int @default(0)
  enabled   Boolean @default(true)
  startAt   DateTime?
  endAt     DateTime?
}

model HomepageSection {
  id        String @id @default(cuid())
  kind      String
  title     String?
  config    String @default("{}")
  sortOrder Int @default(0)
  enabled   Boolean @default(true)
}

model NavigationItem {
  id        String @id @default(cuid())
  menu      String // announcement | primary | footer-shop | footer-service | footer-about | mobile
  label     String
  url       String
  parentId  String?
  icon      String?
  badge     String?
  sortOrder Int @default(0)
  enabled   Boolean @default(true)
  startAt   DateTime?
  endAt     DateTime?
}

model Media {
  id        String @id @default(cuid())
  url       String
  name      String
  mime      String?
  size      Int?
  tags      String @default("[]")
  alt       String?
  folder    String?
  deletedAt DateTime?
  createdAt DateTime @default(now())
}

model SitePage {
  id             String @id @default(cuid())
  slug           String @unique
  title          String
  body           String @default("")
  status         String @default("published")
  seoTitle       String?
  seoDescription String?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String @default("")
}

model Notification {
  id        String @id @default(cuid())
  userId    String?
  user      User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  channel   String @default("email")
  title     String
  body      String?
  read      Boolean @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String @id @default(cuid())
  actorId   String?
  actor     User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  module    String
  recordId  String?
  before    String?
  after     String?
  ip        String?
  createdAt DateTime @default(now())
}

model RecentlyViewed {
  id        String @id @default(cuid())
  userId    String?
  user      User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId String?
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now())
}

model PriceAlert {
  id        String @id @default(cuid())
  userId    String
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([userId, productId])
}

model SupportTicket {
  id        String @id @default(cuid())
  name      String
  email     String
  mobile    String?
  orderNumber String?
  subject   String
  message   String
  status    String @default("open")
  createdAt DateTime @default(now())
}
