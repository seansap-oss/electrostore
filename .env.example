# Electrostore — environment template. Copy to .env and fill in real secrets. Never commit .env.
DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-to-a-long-random-string-min-32-chars"
ADMIN_EMAIL="admin@electrostore.com.au"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_NAME="Store Owner"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_STORE_NAME="Electrostore"
# Payments (configure later — abstraction layer ready)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
# Email (SMTP for transactional mail)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Electrostore <hello@electrostore.com.au>"
# Storage — local by default; set S3/Supabase when ready
STORAGE_PROVIDER="local"
SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Analytics (admin-configurable, no code edits needed)
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
